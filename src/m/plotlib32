\define DrawColumnFuzzFetch32 = {
	ldr	lr, [r4, #0]
	and	r5, lr, #0xff
	subs	r5, r5, #fuzz_darken
	movlt	r5, #0
	and	r1, lr, #0xff00
	subs	r1, r1, #(fuzz_darken << 8)
	orrgt	r5, r5, r1
	and	r1, lr, #0xff0000
	subs	r1, r1, #(fuzz_darken << 16)
	orrgt	r5, r5, r1
}
