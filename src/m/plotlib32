\co
\co Make pixel in lr translucent according to background pixel in pix
\co
\define MakePixelTranslucent(pix) = {
	bic	r9, $pix$, #0xff00
	bic	r6, lr, #0xff00
	add	r9, r9, r6
	mov	r9, r9, lsr #1
	bic	r9, r9, #0xff00
	and	$pix$, $pix$, #0xff00
	and	lr, lr, #0xff00
	add	$pix$, $pix$, lr
	bic	$pix$, $pix$, #0x100
	orr	r9, r9, $pix$, lsr #1
}
