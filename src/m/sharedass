\co
\co Function prototype
\co
\define DefineFunction(name) = {
	AREA	|$name$\$\$Code|, CODE, READONLY
	ALIGN	4
	EXPORT	|$name$|
	=	"$name$"
	ALIGN	4
|$name$|
}
\co
\co 26/32bit APCS
\co
\if defined APCS32
\co 32bit only
\define ReturnFromLR = {
	mov	pc, lr
}
\define PopAndReturn(regs) = {
	ldmia	sp!, \{$regs$, pc\}
}
\define PopAndReturn0 = {
	ldmia	sp!, \{pc\}
}
\endif
\if defined APCS26
\co 26bit only
\define ReturnFromLR = {
	movs	pc, lr
}
\define PopAndReturn(regs) = {
	ldmia	sp!, \{$regs$, pc\}^
}
\define PopAndReturn0 = {
	ldmia	sp!, \{pc\}^
}
\endif
\co Default: any architecture
\if !defined ReturnFromLR
\define ReturnFromLR = {
	teq	r0, r0
	teq	pc, pc
	moveq	pc, lr
	movs	pc, lr
}
\define PopAndReturn(regs) = {
	ldmia	sp!, \{$regs$, lr\}
ReturnFromLR
}
\define PopAndReturn0 = {
	ldmia	sp!, \{lr\}
ReturnFromLR
}
\endif
