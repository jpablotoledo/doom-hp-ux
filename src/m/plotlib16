\define DrawColumnBodyTranslucent(prefix,fetch,aux,get,off,abort) = {
	mov	r0, r0, lsl #1		; 16bpp ==> 2*width
	tst	r4, #3
	beq	|$prefix$lowloop|
	bic	r4, r4, #3
|$prefix$highloop|
$get$(r7,$off$,$abort$)
DrawColumnFetchCheckSlot($fetch$,$aux$,($off$+8),$abort$)
	mov	$aux$, r7, lsr #16
	bic	r7, r7, $aux$, lsl #16
MakePixelTranslucent($aux$)
	orr	r7, r7, r9, lsl #16
	str	r7, [r4], r0
	subs	r10, r10, #1
	bgt	|$prefix$highloop|
	b	|$prefix$done|
|$prefix$lowloop|
$get$(r7,$off$,$abort$)
DrawColumnFetchCheckSlot($fetch$,$aux$,($off$+8),$abort$)
	mov	$aux$, r7, lsr #16
	bic	r7, r7, $aux$, lsl #16
MakePixelTranslucent(r7)
	orr	r9, r9, $aux$, lsl #16
	str	r9, [r4], r0
	subs	r10, r10, #1
	bgt	|$prefix$lowloop|
|$prefix$done|
}
