	bge	|Rarm_DVBbigtop|
|Rarm_DVBsmalltop|
	adds	r10, r10, #0x1c
	ble	|Rarm_DVBtopdone|
	tst	r10, #0x10
	ldmneia	r1!, {r6-r9}
	stmneia	r0!, {r6-r9}
	tst	r10, #8
	ldmneia	r1!, {r7,r8}
	stmneia	r0!, {r7,r8}
