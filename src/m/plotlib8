\define DrawColumnFetchNormal8 = {
	ldrb	lr, [r5, r1, asr #16]
	adds	r1, r1, r2
	ldrb	lr, [r3, lr]
	subcs	r1, r1, r8, lsl #16
}
\define DrawColumnPlotNormal8 = {
DrawColumnFetchNormal8
