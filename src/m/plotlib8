DefineFunction(InstallPalette)
	stmdb	sp!,{r4,lr}
	mov	r2, r0
	sub	sp, sp, #8
	add	r1, sp, #3
	mov	r3, #0
	mov	r0, #0x0c
|IPaLoop|
	strb	r3, [r1, #0]
	ldrb	r4, [r2], #1
	mov	r4, r4, lsl #8
	orr	r4, r4, #0x10
	ldrb	lr, [r2], #1
	orr	r4, r4, lr, lsl #16
	ldrb	lr, [r2], #1
	orr	r4, r4, lr, lsl #24
	str	r4, [r1, #1]
	swi	0x20007			; XOS_Word,12 (set palette)
	add	r3, r3, #1
	cmp	r3, #0x100
	blt	|IPaLoop|
	add	sp, sp, #8
PopAndReturn(r4)




