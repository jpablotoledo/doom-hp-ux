PopAndReturn(r4-$maxreg$)
|$prefix$noresample|
}
\else
\define DrawColumnResampleCore(prefix,fetch,store,minreg,maxreg,unit) = {
DrawColumnResampleGeneric($prefix$,$fetch$,$store$,$minreg$,$unit$)
PopAndReturn(r4-$maxreg$)
