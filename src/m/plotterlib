	subcs	r11, r11, r8
	ldrb	r11, [r5, r11]
	mov	lr, r1, lsl #16
	adds	r1, r1, r2
	ldr	r11, [r3, r11, lsl #2]
	subcs	r1, r1, r8, lsl #16
